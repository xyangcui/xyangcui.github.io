---
import {Button} from "../components";
interface Props {
    class?: string;
    title: string;
    authors: string;
    year: string;
    journal: string;
    abstract: string;
    doi: string;
    bibtex: string;
}

const { class: className, title, authors, year, journal, abstract, doi, bibtex, ...props } = Astro.props;
const myNames = ["Cui Xiangyang", "Xiangyang Cui", "Cui, X. Y.", "X. Y., Cui"];

let authorsHtml = authors;
const myNamesPattern = /(Cui Xiangyang|Xiangyang Cui)/gi;
authorsHtml = authorsHtml.replace(myNamesPattern, `<strong class="font-bold text-[#111827] dark:text-[#D1D5DB]">$&</strong>`);

---

<details style="w-full max-w-[850px];" 
         class="border border-slate-200/60 rounded-2xl p-5 
                bg-white/75
                dark:border-[#36505A]/70 dark:bg-[#19333E]/75
                backdrop-blur-sm shadow-[0_8px_30px_rgba(30,60,80,0.05)] transition-all duration-200 
                hover:-translate-y-0.5 hover:border-red-200/60 hover:shadow-[0_14px_40px_rgba(30,60,80,0.09)]
                dark:hover:border-[#F0D36A]/25 dark:hover:shadow-black/20">
    <summary class="collapse-title">
        <span class="text-lg leading-relaxed text-base-content dark:text-base-content font-semibold" set:html={authorsHtml}></span>
        <span class="text-lg leading-relaxed text-base-content dark:text-base-content font-semibold"> ({year}). </span>
        <span class="text-lg leading-relaxed text-base-content dark:text-base-content font-semibold">{title}.</span>
        <span class="text-lg leading-relaxed text-base-content text-[#8F3B46] dark:text-base-content italic font-bold dark:text-[#D08078]"> {journal}.</span>
    </summary>

    <div class="collapse-content ">
        <h3 class="mb-2 text-xs text-base-content/50 font-bold uppercase trackingw-dest dark:text-[#D1D5DB]">abstract</h3>
        <p class="text-[17px] leading-7 text-base-content/80 font-medium">{abstract}</p>
    </div>
    {/* buttons */}
    <div class="flex justify-end gap-2">
        <Button class="rounded-full font-bold dark:text-[#D1D5DB]" title="DOI" href={doi}>
            <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-Width="2.5" stroke-Linecap="round" stroke-Linejoin="round"
                style={{ display: 'inline-block', verticalAlign: 'middle', marginRight: '4px' }} >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            DOI
        </Button>
        
        <Button class="btn btn-sm copy-bib-btn rounded-full font-bold dark:text-[#D1D5DB]" title="Copy BibTeX" copy-bin-btn data-bibtex={bibtex}>
            <svg xmlns="http://www.w3.org/2000/svg" width="1.3em" height="1.3em" fill="currentColor" viewBox="0 0 24 24" 
            style={{ display: 'inline-block', verticalAlign: 'middle', marginRight: '4px' }}>
                <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
            </svg>
            Copy BibTeX
        </Button>
    </div>
</details>

{/* copy board */}
<script>
    document.querySelectorAll(".copy-bib-btn").forEach((button) => {
        button.addEventListener("click", async () => {
            const bibtex = button.getAttribute("data-bibtex") ?? "";
            await navigator.clipboard.writeText(bibtex);

            button.textContent = "Copied!";
            setTimeout(() => {
                button.textContent = "BibTeX";
            }, 1200);
        });
    });
</script>